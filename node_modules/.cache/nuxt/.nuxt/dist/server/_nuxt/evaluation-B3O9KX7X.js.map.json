{"file":"evaluation-B3O9KX7X.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;EAqBA,eAAe,EAAE,QAAQ,MAAM,CAAC;EAChC,MAAM,EAAE,SAAS,YAAY,kBAAkB;EAC/C,MAAM,EAAE,aAAa,aAAa;EAClC,MAAM,EAAE,eAAe,aAAa,eAAe;EACnD,MAAM,EAAE,gBAAgB,oBAAoB,SAAS;EACrD,MAAM,EAAE,iBAAiB,aAAa;EACtC,MAAM,EAAE,qBAAqB,gBAAgB;EAC7C,MAAM,EAAE,oBAAoB,qBAAqB,gBAAgB;EAKjE,MAAM,EAAE,0BAA0B,wBAAwB,mBAAmB;EAW7E,MAAM,iBAAiB,eACrB,SAAS,MAAM,KAAK,GAAG,WAAW;GAChC,IAAI,EAAE;GACN,MAAM,EAAE;GACR,MAAM,iBAAiB,KAAK,CAAC,CAAC;GAC9B,OAAO,EAAE;EACX,EAAE,CACJ;EAEA,MAAM,4BAA4B,IAAmB,IAAI;EACzD,MAAM,aAAa,IAAI,KAAK;;;;;;;;;;;;;;;;;;EAwB5B,eAAe,eAA8B;GAC3C,IAAI,CAAC,0BAA0B,SAAS,WAAW,OAAO;GAC1D,WAAW,QAAQ;GACnB,IAAI;IACF,mBAAmB,0BAA0B,KAAK;IAElD,MAAM,oBAAoB,eAAe;IACzC,MAAM,mBAAmB,QAAQ,OAAO,YAAY,QAAQ,OAAO,OAAO;IAC1E,IAAI,eAA8B;IAClC,IAAI,8BAAa,IAAI,KAAK,EAAA,CAAE,YAAY;IAMxC,MAAM,oBAAoB,eAAe,MACtC,QAAQ,MAAM,yBAAyB,EAAE,EAAE,CAAC,CAAC,CAC7C,KAAK,OAAO;KAAE,MAAM,EAAE;KAAM,QAAQ;IAAE,EAAE;IAC3C,MAAM,kBAAkB,eAAe,MAAM,MAC1C,MAAM,EAAE,OAAO,0BAA0B,KAC5C;IAEA,IAAI,cAAc,OAChB,SAAS;SACJ,IAAI,QAAQ,OAAO,YAAY,mBAAmB;KACvD,IAAI;MACF,MAAM,aAAa;OACjB,SAAS;OACT,QAAQ,QAAQ,MAAM;OACtB,WAAW,QAAQ,MAAM;OACzB,uBAAuB,iBAAiB,SAAS;MACnD,CAAC;KACH,SAAS,KAAK;MACZ,QAAQ,MAAM,oCAAoC,GAAG;KACvD;KACA,MAAM,QAAQ,MAAM,gBAAgB,QAAQ,MAAM,QAAQ;KAC1D,IAAI,OAAO;MACT,eAAe,MAAM,aAAa;MAClC,aAAa,MAAM,WAAW;KAChC;IACF;IAEA,iBAAiB;KACf,MAAM,cAAc,QAAQ,YAAY;KACxC,WAAW;KACX,SAAS;KACT,UAAU;KACV,YAAY;KACZ,SAAS,cAAc,QAAQ,OAAO;KACtC,QAAQ;KACR,aAAa;IACf,CAAC;GACH,UAAU;IACR,WAAW,QAAQ;GACrB;GACA,MAAM,WAAW,gBAAgB;EACnC;;;;;GAIO,MAAA,OAAA,eAAA,WAAA,EAAA,OAAM,OAAM,GAAA,MAAA,CAAA,EAAA,kBAAA;;IACH,OAAM;IAAa,WAAQ;;GAC3B,IAAA,CAAA,MAAA,OAAA,GAAO;;;KACV,MAAK;KAAoB,OAAM;;;;;IAOjB,cAAA,MAAA,cAAA,IAAV,WAAM;KAIiB,MAAA,gCAAA,eAAA,CAAA,EAAA,oBAAA,MAAA,yBAAA,MAA8B,OAAO,GAAE,GAAA,QAAA,CAAA,EAAA,+DAGvC,eAAA,OAAO,IAAI,EAAA,oDACX,eAAA,OAAO,IAAI,EAAA,iBAAA;;;;KAK3C,OAAA;KACA,MAAK;KACL,OAAM;KACL,SAAS,MAAA,UAAA;KACT,UAAQ,CAAG,MAAA,yBAAA,KAA6B,MAAA,UAAA;KACxC,SAAO;;KANV,SAAA,SASU,GAAA,OAAA,SAAA,aAAA;;WAFT,OAAA,CAAA,gBAAA,iBAED,CAAA","names":[],"sources":["../../../../../../../pages/evaluation.vue","../../../../../../../pages/evaluation.vue"],"sourcesContent":["<script setup lang=\"ts\">\r\n/**\r\n * pages/evaluation.vue\r\n * ---------------------------------------------------------------------------\r\n * หน้าแบบประเมิน \"ท่านชอบฐานใดมากที่สุด?\" — เลือกได้ 1 จากฐานทั้งหมด (แสดงชื่อ\r\n * จริง จำนวน/ลำดับมาจาก Backend ไม่ hardcode ว่ามี 4 ฐาน) เข้ามาจากปุ่ม \"จบเกม\"\r\n * ที่หน้าฐานสุดท้าย (ดู pages/station/[stationId].vue::handleEndGame()) กด\r\n * \"ส่งแบบประเมิน\" แล้วพาไปหน้าสรุปผล/รางวัลเดิมของโปรเจกต์\r\n * (pages/round-summary.vue — ดูเหตุผลที่ใช้หน้านี้แทนที่จะสร้างหน้า Reward ใหม่\r\n * ในคอมเมนต์ handleSubmit ด้านล่าง)\r\n *\r\n * ใช้ submitSurvey() จริงของระบบเดิม (server-gas/SurveyService.gs — ระบบ Survey\r\n * นี้เป็นระบบที่ไม่แตะ/ไม่แก้ ไม่ได้ถูก sync กับ backend ล่าสุด) เฉพาะฝั่ง Online\r\n * เท่านั้น — favoriteStationRating ส่งเป็น \"ลำดับ (order)\" ของฐานที่เลือกตรง ๆ\r\n * (แทน mapping ตายตัว corn=1/soil=2/cow=3/milk=4 เดิม ซึ่งผูกกับ 4 ฐานคงที่)\r\n * ไม่ได้สร้าง API ใหม่ใด ๆ ฝั่ง Offline ไม่มี Round ฝั่ง Backend ให้บันทึกอยู่แล้ว\r\n * จึงเก็บแค่ในเครื่อง ไม่ Submit ไม่สำเร็จก็ไม่บล็อกผู้เล่น (รอบนี้เป็น Feedback\r\n * เสริม ไม่ใช่เงื่อนไขบังคับ)\r\n */\r\nimport { getStationVisual } from \"~/composables/useAdventure\";\r\n\r\ndefinePageMeta({ layout: \"app\" });\r\nconst { profile, isReady } = useRequireProfile();\r\nconst { stations } = useAdventure();\r\nconst { isOfflineMode, endRound } = useOfflineMode();\r\nconst { currentRoundId, endCurrentRound } = useRound();\r\nconst { submitSurvey } = useMemberApi();\r\nconst { saveRoundSummary } = useRoundSummary();\r\nconst { setFavoriteStation, initStationQuest } = useStationQuest();\r\n// [แก้ไข] \"ฐานที่เล่นครบภารกิจแล้ว\" ตอนนี้มาจาก composables/useStationMissions.ts\r\n// (Backend เป็นเจ้าของความจริง) แทน useStationQuest() เดิม (mockScore/\r\n// getStationMissions ที่นี่ถูกลบไปแล้ว — คะแนนรวมของรอบตอนนี้ pages/\r\n// round-summary.vue ดึงจาก useRoundScores() เองแทน ไม่ต้องส่งสำเนามาทางนี้อีก)\r\nconst { isStationMissionComplete, initStationMissions } = useStationMissions();\r\n\r\n/** เรียกซ้ำเพื่อความปลอดภัย (ปกติหน้าฐานสุดท้ายที่พามาถึงนี่โหลดไปแล้ว) —\r\n * กันเคส Hard Refresh ตรงหน้านี้เอง (ดู composables/useStationQuest.ts) —\r\n * initStationMissions() ก็เช่นกัน (restore Cache ของทุกฐานที่เคยเข้ามาในรอบนี้\r\n * ไม่ใช่แค่ฐานสุดท้ายที่พามาถึงหน้านี้) */\r\nonMounted(async () => {\r\n  await initStationQuest();\r\n  initStationMissions();\r\n});\r\n\r\nconst stationChoices = computed(() =>\r\n  stations.value.map((s, index) => ({\r\n    id: s.id,\r\n    name: s.name,\r\n    icon: getStationVisual(index).icon,\r\n    order: s.order,\r\n  })),\r\n);\r\n\r\nconst selectedFavoriteStationId = ref<string | null>(null);\r\nconst submitting = ref(false);\r\n\r\nfunction selectStation(id: string): void {\r\n  if (submitting.value) return;\r\n  selectedFavoriteStationId.value = id;\r\n}\r\n\r\n/**\r\n * กด \"ส่งแบบประเมิน\" — เก็บฐานที่เลือกไว้ในเครื่องเสมอ (setFavoriteStation) แล้ว\r\n * ปิด Round ตามช่องทางเดิมของระบบ (Online: submitSurvey() + endCurrentRound() /\r\n * Offline: endRound()) ก่อนเก็บสรุปผล \"รอบนี้\" ด้วยข้อมูล Mock (ฐานที่ทำครบ 3/3\r\n * + mockScore) ผ่าน useRoundSummary เดิม แล้วพาไป /round-summary\r\n *\r\n * [Fix — root cause ของ \"หน้าสรุปผลขึ้น 0 คะแนน/ไม่มีฐานที่เล่นเลย ทั้งที่เพิ่งเล่น\r\n * ครบ 4 ฐาน\"] เดิมอ่าน completedStations/mockScore \"หลัง\" เรียก endCurrentRound()\r\n * ไปแล้ว — endCurrentRound() เคลียร์ currentRoundId เป็น null ใน finally ของมันเอง\r\n * เสมอ ซึ่งเปลี่ยน effectiveRoundKey ใน useStationQuest.ts ทันที (จาก\r\n * \"online:<roundId>\" เป็น \"no-round\") ไป Trigger watch(effectiveRoundKey) ที่นั่น\r\n * ให้เข้าใจว่า \"เปลี่ยนรอบใหม่แล้ว\" แล้วล้าง Progress/mockScore ทั้งหมดทิ้งทันที\r\n * ก่อนที่โค้ดด้านล่างจะทันได้อ่านค่าจริงเสียอีก (อ่านได้ค่าว่างเปล่าเสมอ) แก้โดย\r\n * จับค่าสรุปผลทั้งหมด (completedStations/correctCount/mockScore) ไว้ \"ก่อน\" เรียก\r\n * endCurrentRound()/submitSurvey()/endRound() เสมอ — เหมือนที่ต้องจับ roundId ไว้\r\n * ก่อนด้วยเหตุผลเดียวกัน (ดู pages/scan.vue เดิม)\r\n */\r\nasync function handleSubmit(): Promise<void> {\r\n  if (!selectedFavoriteStationId.value || submitting.value) return;\r\n  submitting.value = true;\r\n  try {\r\n    setFavoriteStation(selectedFavoriteStationId.value);\r\n\r\n    const roundIdForSummary = currentRoundId.value;\r\n    const userIdForSummary = profile.value?.memberId || profile.value?.uid || null;\r\n    let startTimeIso: string | null = null;\r\n    let endTimeIso = new Date().toISOString();\r\n\r\n    // [Fix] จับค่าสรุปผลไว้ก่อนเสมอ ก่อนเรียกอะไรที่อาจทำให้ Round เปลี่ยน/จบ (ดู\r\n    // คอมเมนต์ด้านบน) — เหลือแค่ชื่อฐานที่เล่นครบภารกิจแล้ว (คะแนนรวมจริงของรอบนี้\r\n    // pages/round-summary.vue ดึงจาก useRoundScores() เองแทน ไม่ต้องคำนวณ/ส่ง\r\n    // สำเนามาทางนี้อีกต่อไป)\r\n    const completedStations = stationChoices.value\r\n      .filter((s) => isStationMissionComplete(s.id))\r\n      .map((s) => ({ name: s.name, points: 0 }));\r\n    const selectedStation = stationChoices.value.find(\r\n      (s) => s.id === selectedFavoriteStationId.value,\r\n    );\r\n\r\n    if (isOfflineMode.value) {\r\n      endRound();\r\n    } else if (profile.value?.memberId && roundIdForSummary) {\r\n      try {\r\n        await submitSurvey({\r\n          roundId: roundIdForSummary,\r\n          userId: profile.value.memberId,\r\n          firstName: profile.value.firstName,\r\n          favoriteStationRating: selectedStation?.order ?? 1,\r\n        });\r\n      } catch (err) {\r\n        console.error(\"[evaluation] submitSurvey failed\", err);\r\n      }\r\n      const ended = await endCurrentRound(profile.value.memberId);\r\n      if (ended) {\r\n        startTimeIso = ended.startTime || null;\r\n        endTimeIso = ended.endTime || endTimeIso;\r\n      }\r\n    }\r\n\r\n    saveRoundSummary({\r\n      mode: isOfflineMode.value ? \"offline\" : \"online\",\r\n      startTime: startTimeIso,\r\n      endTime: endTimeIso,\r\n      stations: completedStations,\r\n      totalPoint: null,\r\n      roundId: isOfflineMode.value ? null : roundIdForSummary,\r\n      userId: userIdForSummary,\r\n      endedReason: \"manual\",\r\n    });\r\n  } finally {\r\n    submitting.value = false;\r\n  }\r\n  await navigateTo(\"/round-summary\");\r\n}\r\n</script>\r\n\r\n<template>\r\n  <div class=\"page\">\r\n    <PageHeader title=\"แบบประเมิน\" back-to=\"/stations\" />\r\n    <div v-if=\"!isReady\" class=\"page__loading\">\r\n      <UIcon name=\"i-lucide-loader-2\" class=\"page__spinner\" />\r\n    </div>\r\n    <div v-else class=\"page__content\">\r\n      <p class=\"page__question\">ท่านชอบฐานใดมากที่สุด?</p>\r\n\r\n      <div class=\"choice-list\">\r\n        <button\r\n          v-for=\"choice in stationChoices\"\r\n          :key=\"choice.id\"\r\n          type=\"button\"\r\n          class=\"choice\"\r\n          :class=\"{ 'choice--selected': selectedFavoriteStationId === choice.id }\"\r\n          @click=\"selectStation(choice.id)\"\r\n        >\r\n          <span class=\"choice__icon\">{{ choice.icon }}</span>\r\n          <span class=\"choice__name\">{{ choice.name }}</span>\r\n        </button>\r\n      </div>\r\n\r\n      <UButton\r\n        block\r\n        size=\"xl\"\r\n        color=\"primary\"\r\n        :loading=\"submitting\"\r\n        :disabled=\"!selectedFavoriteStationId || submitting\"\r\n        @click=\"handleSubmit\"\r\n      >\r\n        ส่งแบบประเมิน\r\n      </UButton>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<style scoped>\r\n.page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100%;\r\n}\r\n\r\n.page__loading {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.page__spinner {\r\n  width: 2.5rem;\r\n  height: 2.5rem;\r\n  animation: evaluation-spin 1s linear infinite;\r\n  color: var(--farm-accent-dark);\r\n}\r\n\r\n.page__content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.25rem;\r\n  padding: 0.5rem 1.1rem 2rem;\r\n}\r\n\r\n.page__question {\r\n  margin: 0;\r\n  text-align: center;\r\n  font-size: 1.1rem;\r\n  font-weight: 800;\r\n  color: var(--farm-text-dark);\r\n}\r\n\r\n.choice-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.65rem;\r\n}\r\n\r\n.choice {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  padding: 1rem 1.1rem;\r\n  border-radius: 1rem;\r\n  border: 2px solid var(--farm-wood);\r\n  background: var(--farm-cream);\r\n}\r\n\r\n.choice__icon {\r\n  font-size: 1.85rem;\r\n  line-height: 1;\r\n}\r\n\r\n.choice__name {\r\n  font-size: 1.05rem;\r\n  font-weight: 700;\r\n  color: var(--farm-text-dark);\r\n}\r\n\r\n.choice--selected {\r\n  border-color: var(--farm-accent-dark);\r\n  background: var(--farm-accent);\r\n}\r\n\r\n.choice--selected .choice__name {\r\n  color: var(--farm-cream);\r\n}\r\n\r\n@keyframes evaluation-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n</style>\r\n","<script setup lang=\"ts\">\r\n/**\r\n * pages/evaluation.vue\r\n * ---------------------------------------------------------------------------\r\n * หน้าแบบประเมิน \"ท่านชอบฐานใดมากที่สุด?\" — เลือกได้ 1 จากฐานทั้งหมด (แสดงชื่อ\r\n * จริง จำนวน/ลำดับมาจาก Backend ไม่ hardcode ว่ามี 4 ฐาน) เข้ามาจากปุ่ม \"จบเกม\"\r\n * ที่หน้าฐานสุดท้าย (ดู pages/station/[stationId].vue::handleEndGame()) กด\r\n * \"ส่งแบบประเมิน\" แล้วพาไปหน้าสรุปผล/รางวัลเดิมของโปรเจกต์\r\n * (pages/round-summary.vue — ดูเหตุผลที่ใช้หน้านี้แทนที่จะสร้างหน้า Reward ใหม่\r\n * ในคอมเมนต์ handleSubmit ด้านล่าง)\r\n *\r\n * ใช้ submitSurvey() จริงของระบบเดิม (server-gas/SurveyService.gs — ระบบ Survey\r\n * นี้เป็นระบบที่ไม่แตะ/ไม่แก้ ไม่ได้ถูก sync กับ backend ล่าสุด) เฉพาะฝั่ง Online\r\n * เท่านั้น — favoriteStationRating ส่งเป็น \"ลำดับ (order)\" ของฐานที่เลือกตรง ๆ\r\n * (แทน mapping ตายตัว corn=1/soil=2/cow=3/milk=4 เดิม ซึ่งผูกกับ 4 ฐานคงที่)\r\n * ไม่ได้สร้าง API ใหม่ใด ๆ ฝั่ง Offline ไม่มี Round ฝั่ง Backend ให้บันทึกอยู่แล้ว\r\n * จึงเก็บแค่ในเครื่อง ไม่ Submit ไม่สำเร็จก็ไม่บล็อกผู้เล่น (รอบนี้เป็น Feedback\r\n * เสริม ไม่ใช่เงื่อนไขบังคับ)\r\n */\r\nimport { getStationVisual } from \"~/composables/useAdventure\";\r\n\r\ndefinePageMeta({ layout: \"app\" });\r\nconst { profile, isReady } = useRequireProfile();\r\nconst { stations } = useAdventure();\r\nconst { isOfflineMode, endRound } = useOfflineMode();\r\nconst { currentRoundId, endCurrentRound } = useRound();\r\nconst { submitSurvey } = useMemberApi();\r\nconst { saveRoundSummary } = useRoundSummary();\r\nconst { setFavoriteStation, initStationQuest } = useStationQuest();\r\n// [แก้ไข] \"ฐานที่เล่นครบภารกิจแล้ว\" ตอนนี้มาจาก composables/useStationMissions.ts\r\n// (Backend เป็นเจ้าของความจริง) แทน useStationQuest() เดิม (mockScore/\r\n// getStationMissions ที่นี่ถูกลบไปแล้ว — คะแนนรวมของรอบตอนนี้ pages/\r\n// round-summary.vue ดึงจาก useRoundScores() เองแทน ไม่ต้องส่งสำเนามาทางนี้อีก)\r\nconst { isStationMissionComplete, initStationMissions } = useStationMissions();\r\n\r\n/** เรียกซ้ำเพื่อความปลอดภัย (ปกติหน้าฐานสุดท้ายที่พามาถึงนี่โหลดไปแล้ว) —\r\n * กันเคส Hard Refresh ตรงหน้านี้เอง (ดู composables/useStationQuest.ts) —\r\n * initStationMissions() ก็เช่นกัน (restore Cache ของทุกฐานที่เคยเข้ามาในรอบนี้\r\n * ไม่ใช่แค่ฐานสุดท้ายที่พามาถึงหน้านี้) */\r\nonMounted(async () => {\r\n  await initStationQuest();\r\n  initStationMissions();\r\n});\r\n\r\nconst stationChoices = computed(() =>\r\n  stations.value.map((s, index) => ({\r\n    id: s.id,\r\n    name: s.name,\r\n    icon: getStationVisual(index).icon,\r\n    order: s.order,\r\n  })),\r\n);\r\n\r\nconst selectedFavoriteStationId = ref<string | null>(null);\r\nconst submitting = ref(false);\r\n\r\nfunction selectStation(id: string): void {\r\n  if (submitting.value) return;\r\n  selectedFavoriteStationId.value = id;\r\n}\r\n\r\n/**\r\n * กด \"ส่งแบบประเมิน\" — เก็บฐานที่เลือกไว้ในเครื่องเสมอ (setFavoriteStation) แล้ว\r\n * ปิด Round ตามช่องทางเดิมของระบบ (Online: submitSurvey() + endCurrentRound() /\r\n * Offline: endRound()) ก่อนเก็บสรุปผล \"รอบนี้\" ด้วยข้อมูล Mock (ฐานที่ทำครบ 3/3\r\n * + mockScore) ผ่าน useRoundSummary เดิม แล้วพาไป /round-summary\r\n *\r\n * [Fix — root cause ของ \"หน้าสรุปผลขึ้น 0 คะแนน/ไม่มีฐานที่เล่นเลย ทั้งที่เพิ่งเล่น\r\n * ครบ 4 ฐาน\"] เดิมอ่าน completedStations/mockScore \"หลัง\" เรียก endCurrentRound()\r\n * ไปแล้ว — endCurrentRound() เคลียร์ currentRoundId เป็น null ใน finally ของมันเอง\r\n * เสมอ ซึ่งเปลี่ยน effectiveRoundKey ใน useStationQuest.ts ทันที (จาก\r\n * \"online:<roundId>\" เป็น \"no-round\") ไป Trigger watch(effectiveRoundKey) ที่นั่น\r\n * ให้เข้าใจว่า \"เปลี่ยนรอบใหม่แล้ว\" แล้วล้าง Progress/mockScore ทั้งหมดทิ้งทันที\r\n * ก่อนที่โค้ดด้านล่างจะทันได้อ่านค่าจริงเสียอีก (อ่านได้ค่าว่างเปล่าเสมอ) แก้โดย\r\n * จับค่าสรุปผลทั้งหมด (completedStations/correctCount/mockScore) ไว้ \"ก่อน\" เรียก\r\n * endCurrentRound()/submitSurvey()/endRound() เสมอ — เหมือนที่ต้องจับ roundId ไว้\r\n * ก่อนด้วยเหตุผลเดียวกัน (ดู pages/scan.vue เดิม)\r\n */\r\nasync function handleSubmit(): Promise<void> {\r\n  if (!selectedFavoriteStationId.value || submitting.value) return;\r\n  submitting.value = true;\r\n  try {\r\n    setFavoriteStation(selectedFavoriteStationId.value);\r\n\r\n    const roundIdForSummary = currentRoundId.value;\r\n    const userIdForSummary = profile.value?.memberId || profile.value?.uid || null;\r\n    let startTimeIso: string | null = null;\r\n    let endTimeIso = new Date().toISOString();\r\n\r\n    // [Fix] จับค่าสรุปผลไว้ก่อนเสมอ ก่อนเรียกอะไรที่อาจทำให้ Round เปลี่ยน/จบ (ดู\r\n    // คอมเมนต์ด้านบน) — เหลือแค่ชื่อฐานที่เล่นครบภารกิจแล้ว (คะแนนรวมจริงของรอบนี้\r\n    // pages/round-summary.vue ดึงจาก useRoundScores() เองแทน ไม่ต้องคำนวณ/ส่ง\r\n    // สำเนามาทางนี้อีกต่อไป)\r\n    const completedStations = stationChoices.value\r\n      .filter((s) => isStationMissionComplete(s.id))\r\n      .map((s) => ({ name: s.name, points: 0 }));\r\n    const selectedStation = stationChoices.value.find(\r\n      (s) => s.id === selectedFavoriteStationId.value,\r\n    );\r\n\r\n    if (isOfflineMode.value) {\r\n      endRound();\r\n    } else if (profile.value?.memberId && roundIdForSummary) {\r\n      try {\r\n        await submitSurvey({\r\n          roundId: roundIdForSummary,\r\n          userId: profile.value.memberId,\r\n          firstName: profile.value.firstName,\r\n          favoriteStationRating: selectedStation?.order ?? 1,\r\n        });\r\n      } catch (err) {\r\n        console.error(\"[evaluation] submitSurvey failed\", err);\r\n      }\r\n      const ended = await endCurrentRound(profile.value.memberId);\r\n      if (ended) {\r\n        startTimeIso = ended.startTime || null;\r\n        endTimeIso = ended.endTime || endTimeIso;\r\n      }\r\n    }\r\n\r\n    saveRoundSummary({\r\n      mode: isOfflineMode.value ? \"offline\" : \"online\",\r\n      startTime: startTimeIso,\r\n      endTime: endTimeIso,\r\n      stations: completedStations,\r\n      totalPoint: null,\r\n      roundId: isOfflineMode.value ? null : roundIdForSummary,\r\n      userId: userIdForSummary,\r\n      endedReason: \"manual\",\r\n    });\r\n  } finally {\r\n    submitting.value = false;\r\n  }\r\n  await navigateTo(\"/round-summary\");\r\n}\r\n</script>\r\n\r\n<template>\r\n  <div class=\"page\">\r\n    <PageHeader title=\"แบบประเมิน\" back-to=\"/stations\" />\r\n    <div v-if=\"!isReady\" class=\"page__loading\">\r\n      <UIcon name=\"i-lucide-loader-2\" class=\"page__spinner\" />\r\n    </div>\r\n    <div v-else class=\"page__content\">\r\n      <p class=\"page__question\">ท่านชอบฐานใดมากที่สุด?</p>\r\n\r\n      <div class=\"choice-list\">\r\n        <button\r\n          v-for=\"choice in stationChoices\"\r\n          :key=\"choice.id\"\r\n          type=\"button\"\r\n          class=\"choice\"\r\n          :class=\"{ 'choice--selected': selectedFavoriteStationId === choice.id }\"\r\n          @click=\"selectStation(choice.id)\"\r\n        >\r\n          <span class=\"choice__icon\">{{ choice.icon }}</span>\r\n          <span class=\"choice__name\">{{ choice.name }}</span>\r\n        </button>\r\n      </div>\r\n\r\n      <UButton\r\n        block\r\n        size=\"xl\"\r\n        color=\"primary\"\r\n        :loading=\"submitting\"\r\n        :disabled=\"!selectedFavoriteStationId || submitting\"\r\n        @click=\"handleSubmit\"\r\n      >\r\n        ส่งแบบประเมิน\r\n      </UButton>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<style scoped>\r\n.page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100%;\r\n}\r\n\r\n.page__loading {\r\n  flex: 1;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.page__spinner {\r\n  width: 2.5rem;\r\n  height: 2.5rem;\r\n  animation: evaluation-spin 1s linear infinite;\r\n  color: var(--farm-accent-dark);\r\n}\r\n\r\n.page__content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.25rem;\r\n  padding: 0.5rem 1.1rem 2rem;\r\n}\r\n\r\n.page__question {\r\n  margin: 0;\r\n  text-align: center;\r\n  font-size: 1.1rem;\r\n  font-weight: 800;\r\n  color: var(--farm-text-dark);\r\n}\r\n\r\n.choice-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.65rem;\r\n}\r\n\r\n.choice {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  padding: 1rem 1.1rem;\r\n  border-radius: 1rem;\r\n  border: 2px solid var(--farm-wood);\r\n  background: var(--farm-cream);\r\n}\r\n\r\n.choice__icon {\r\n  font-size: 1.85rem;\r\n  line-height: 1;\r\n}\r\n\r\n.choice__name {\r\n  font-size: 1.05rem;\r\n  font-weight: 700;\r\n  color: var(--farm-text-dark);\r\n}\r\n\r\n.choice--selected {\r\n  border-color: var(--farm-accent-dark);\r\n  background: var(--farm-accent);\r\n}\r\n\r\n.choice--selected .choice__name {\r\n  color: var(--farm-cream);\r\n}\r\n\r\n@keyframes evaluation-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n</style>\r\n"],"version":3}